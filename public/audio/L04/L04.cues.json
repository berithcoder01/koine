  "cues": [
    {
      "id": "titulo",
      "marker": "TITULO",
      "text": "Lição 4 — Consoantes com a Língua",
      "startTime": 0.0,
      "endTime": 1.95
    },
    {
      "id": "introducao",
      "marker": "INTRODUCAO",
      "text": "Hoje vamos estudar as consoantes dentais. Esses sons são produzidos com a língua nos dentes: delta, tau e teta. Abra sua apostila na página 7.",
      "startTime": 3.95,
      "endTime": 12.22
    },
    {
      "id": "exposicao",
      "marker": "EXPOSICAO",
      "text": "A primeira letra é o delta. Maiúsculo: Δ. Minúsculo: δ. O som é 'd', como em 'dado'.",
      "startTime": 13.22,
      "endTime": 18.95
    },
    {
      "id": "exposicao_2",
      "marker": "EXPOSICAO",
      "text": "Observe a ordem dos traços da letra δ. Acompanhe a animação na tela.",
      "startTime": 19.45,
      "endTime": 23.53
    },
    {
      "id": "exposicao_3",
      "marker": "EXPOSICAO",
      "text": "Agora escreva o delta minúsculo oito vezes na linha 1 da sua apostila. Mantenha o ritmo: uma letra por clique.",
      "startTime": 24.03,
      "endTime": 29.98
    },
    {
      "id": "exposicao_4",
      "marker": "EXPOSICAO",
      "text": "A segunda letra é o tau. Maiúsculo: Τ. Minúsculo: τ. O som é 't', como em 'tudo'.",
      "startTime": 30.48,
      "endTime": 36.13
    },
    {
      "id": "exposicao_5",
      "marker": "EXPOSICAO",
      "text": "Observe a ordem dos traços da letra τ. Acompanhe a animação na tela.",
      "startTime": 36.63,
      "endTime": 40.56
    },
    {
      "id": "exposicao_6",
      "marker": "EXPOSICAO",
      "text": "Agora escreva o tau minúsculo oito vezes na linha 2 da sua apostila. Mantenha o ritmo: uma letra por clique.",
      "startTime": 41.06,
      "endTime": 46.92
    },
    {
      "id": "exposicao_7",
      "marker": "EXPOSICAO",
      "text": "A terceira letra é o teta. Maiúsculo: Θ. Minúsculo: θ. O som é 'th' aspirado, como em 'think' do inglês.",
      "startTime": 47.42,
      "endTime": 54.04
    },
    {
      "id": "exposicao_8",
      "marker": "EXPOSICAO",
      "text": "Observe a ordem dos traços da letra θ. Acompanhe a animação na tela.",
      "startTime": 54.54,
      "endTime": 58.68
    },
    {
      "id": "exposicao_9",
      "marker": "EXPOSICAO",
      "text": "Agora escreva o teta minúsculo oito vezes na linha 3 da sua apostila. Mantenha o ritmo: uma letra por clique.",
      "startTime": 59.18,
      "endTime": 65.28
    },
    {
      "id": "pausa",
      "marker": "PAUSA",
      "text": "Excelente! Você aprendeu as três consoantes dentais: delta, tau e teta. Antes de continuar, olhe para o que escreveu e compare com o modelo.",
      "startTime": 65.78,
      "endTime": 73.78
    },
    {
      "id": "ditado",
      "marker": "DITADO",
      "text": "Escreva no papel: delta.",
      "startTime": 75.78,
      "endTime": 77.43
    },
    {
      "id": "ditado_2",
      "marker": "DITADO",
      "text": "Escreva no papel: tau.",
      "startTime": 78.43,
      "endTime": 79.95
    },
    {
      "id": "ditado_3",
      "marker": "DITADO",
      "text": "Escreva no papel: teta.",
      "startTime": 80.95,
      "endTime": 82.69
    },
    {
      "id": "finalizacao",
      "marker": "FINALIZACAO",
      "text": "Parabéns por completar Lição 4 — Consoantes com a Língua! Você concluiu esta lição da apostila Koiné.",
      "startTime": 83.69,
      "endTime": 89.39
    }
