rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Usuários ────────────────────────────────────────────────
    match /users/{userId} {

      // Leitura: apenas o próprio usuário autenticado
      allow read: if request.auth != null && request.auth.uid == userId;

      // Criação: o próprio usuário pode criar seu documento inicial
      // (necessário no cadastro/primeiro login com Google)
      allow create: if request.auth != null && request.auth.uid == userId;

      // Deleção: o próprio usuário pode deletar sua conta
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Update com validação server-side: limita campos sensíveis
      allow update: if request.auth != null
        && request.auth.uid == userId
        // XP total: máximo 500.000 (acumulação de anos)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalXP'])
            || (request.resource.data.totalXP is int
                && request.resource.data.totalXP >= 0
                && request.resource.data.totalXP <= 500000))
        // XP semanal: máximo 5.000
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['weeklyXP'])
            || (request.resource.data.weeklyXP is int
                && request.resource.data.weeklyXP >= 0
                && request.resource.data.weeklyXP <= 5000))
        // Streak dias: máximo 3650 (10 anos)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['streakDays'])
            || (request.resource.data.streakDays is int
                && request.resource.data.streakDays >= 0
                && request.resource.data.streakDays <= 3650))
        // Streak record: máximo 3650
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['streakRecord'])
            || (request.resource.data.streakRecord is int
                && request.resource.data.streakRecord >= 0
                && request.resource.data.streakRecord <= 3650))
        // streakFreezes: máximo 30
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['streakFreezes'])
            || (request.resource.data.streakFreezes is int
                && request.resource.data.streakFreezes >= 0
                && request.resource.data.streakFreezes <= 30))
        // leagueLevel: só valores válidos
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['leagueLevel'])
            || request.resource.data.leagueLevel in ['bronze', 'prata', 'ouro', 'diamante'])
        // Arrays: máximo tamanho razoável (parênteses corretos para precedência OR/AND)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedUnits'])
            || (request.resource.data.completedUnits is list
                && request.resource.data.completedUnits.size() <= 200))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedLessons'])
            || (request.resource.data.completedLessons is list
                && request.resource.data.completedLessons.size() <= 1000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['unlockedVerses'])
            || (request.resource.data.unlockedVerses is list
                && request.resource.data.unlockedVerses.size() <= 500))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['achievements'])
            || (request.resource.data.achievements is list
                && request.resource.data.achievements.size() <= 100));
    }

    // ── Coleção privada do admin (opcional, para futuro) ────────
    // match /admin/{document=**} {
    //   allow read, write: if request.auth != null && request.auth.token.admin == true;
    // }
  }
}
