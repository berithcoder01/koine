{
  "name": "koineapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "download-nt": "tsx src/scripts/downloadNT.ts",
    "download-blivre": "tsx src/scripts/downloadBLivre.ts",
    "build-books": "tsx src/scripts/buildBooks.ts",
    "build-glossary": "tsx src/scripts/buildGlossary.ts",
    "build-interlinear": "tsx src/scripts/buildInterlinear.ts",
    "build-nt-pt": "npm run download-blivre && npm run build-books",
    "parse-apostila": "tsx src/tools/apostilaRunner.ts",
    "parse-apostila:all": "tsx src/tools/apostilaRunner.ts --all",
    "validate-apostila": "tsx src/tools/apostilaRunner.ts --validate",
    "validate-apostila:all": "tsx src/tools/apostilaRunner.ts --validate --all"
  },
  "dependencies": {
    "@capacitor-community/native-audio": "^6.0.0",
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor-community/text-to-speech": "^5.1.0",
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor-firebase/firestore": "^6.3.1",
    "@capacitor-firebase/messaging": "^6.3.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/status-bar": "^6.0.3",
    "@capacitor/toast": "^6.0.4",
    "@heroui/react": "^2.8.10",
    "@revenuecat/purchases-capacitor": "^13.0.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.0",
    "firebase": "^10.14.1",
    "framer-motion": "^12.40.0",
    "immer": "^10.0.0",
    "ionicons": "^7.4.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-medium-image-zoom": "^5.4.7",
    "react-router-dom": "^6.30.3",
    "sharp": "^0.34.5",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "marked": "^18.0.5",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.2.2",
    "vite": "^5.1.0"
  }
}
